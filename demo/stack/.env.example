# Copy to .env on the box (mode 600). The real values are in /root/.config/brazier/demo-credentials on mitochondria.
GRAFANA_ADMIN_PASSWORD=change-me
# The header value the brazier-demo Worker adds; the gate refuses everything else.
DEMO_KEY=change-me
# Same secret the estate's contact point uses: the relay verifies the HMAC with it.
BRAZIER_WEBHOOK_SECRET=change-me
# Authelia, the sign-in gate in front of the fronted Grafana: three random secrets (openssl rand -hex 32 each).
AUTHELIA_JWT_SECRET=change-me
AUTHELIA_SESSION_SECRET=change-me
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me
