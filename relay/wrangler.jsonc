{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brazier-relay",
  // Guys Inc's account. A self-hosted relay changes this, the KV id and the route; nothing else.
  "account_id": "b91113eccd05a2abae65f95733a9403e",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "DEVICES", "id": "66a331538cd347f1b026da1f61090bea" }],
  "observability": { "enabled": true },
  "vars": {
    // The Grafana origins this relay serves. A device may only register through one of these; the relay asks
    // that Grafana who the caller is. Comma separated for several.
    "GRAFANA_URLS": "https://grafana.gicloud.org",
    // How the app signs in to each Grafana through its identity provider, published at /.well-known/brazier.
    // The estate: Keystone's public PKCE client for the app; Grafana's JWT auth trusts that provider.
    "SIGN_IN": "{\"https://grafana.gicloud.org\":{\"issuer\":\"https://keystone.gicloud.org/application/o/brazier/\",\"clientId\":\"vgG1mB1fiCSYrsS2Y7zK7CMd5GdlE5USYP5tIqJh\",\"name\":\"Guys Inc\"}}",
    // Label matcher -> Grafana user (login or email). "*" is the default owner. A value may be a list.
    "ROUTES": "{\"site=meade-manor\":\"dmeade@damp.meme\",\"*\":\"cjackson@guysinc.org\"}",
    "APNS_TEAM_ID": "7VM43528YK",
    "APNS_TOPIC": "org.guysinc.brazier",
    // The APNs key id; the key itself is the APNS_KEY secret. Empty until the key exists.
    "APNS_KEY_ID": "PTDYNZWJJJ"
  },
  // Secrets, set with `wrangler secret put`: WEBHOOK_SECRET, APNS_KEY
  "routes": [{ "pattern": "brazier.gicloud.org", "custom_domain": true }]
}
