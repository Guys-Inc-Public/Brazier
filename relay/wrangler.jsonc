{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brazier-relay",
  // Guys Inc's account. A self-hosted relay changes this, the KV id and the route; nothing else.
  "account_id": "b91113eccd05a2abae65f95733a9403e",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "DEVICES", "id": "66a331538cd347f1b026da1f61090bea" }],
  "observability": { "enabled": true },
  "vars": {
    // Where the app's sign-in tokens come from. The relay verifies them against this JWKS.
    "JWKS_URL": "https://keystone.gicloud.org/application/o/brazier/jwks/",
    "JWT_ISSUER": "https://keystone.gicloud.org/application/o/brazier/",
    "JWT_AUDIENCE": "vgG1mB1fiCSYrsS2Y7zK7CMd5GdlE5USYP5tIqJh",
    // Label matcher -> user (preferred_username). "*" is the default owner. A value may be a list.
    "ROUTES": "{\"site=meade-manor\":\"dmeade\",\"*\":\"cjackson\"}",
    "APNS_TEAM_ID": "7VM43528YK",
    "APNS_TOPIC": "org.guysinc.brazier",
    // The APNs key id; the key itself is the APNS_KEY secret. Empty until the key exists.
    "APNS_KEY_ID": "4B7QX469NS"
  },
  // Secrets, set with `wrangler secret put`: WEBHOOK_SECRET, APNS_KEY
  "routes": [{ "pattern": "brazier.gicloud.org", "custom_domain": true }]
}
